# =============================================================================
# TAA engine environment. Copy to .env and fill in. NEVER commit .env.
# Secrets may reference Windows Credential Manager instead of plain text:
#   MT5_PASSWORD=keyring:taa/mt5-demo
# (store it once with:  python -c "import keyring; keyring.set_password('taa','mt5-demo','...')" )
# Restrict .env to your user:  icacls .env /inheritance:r /grant:r "%USERNAME%:R"
# =============================================================================

# --- Mode (required): BACKTEST | PAPER | DEMO | LIVE --------------------------
TRADING_MODE=PAPER

# --- MetaTrader 5 ----------------------------------------------------------------
# PAPER mode expects the INVESTOR (read-only) password: the bot then cannot trade.
MT5_LOGIN=00000000
MT5_PASSWORD=change-me
# Exact server name as shown in the terminal login dialog, e.g. FBS-Demo or FBS-Real
MT5_SERVER=FBS-Demo
# Terminal selection: keep exactly ONE option active; switch by moving the comment markers.
# Option A (default): dedicated portable copy for the bot. It never switches the account of the terminal
# you trade with manually. Create it by copying the installed terminal folder.
MT5_TERMINAL_PATH=C:\MT5\taa-bot\terminal64.exe
MT5_PORTABLE=true
# Option B: the installed terminal. Faster to set up, but the bot logs in to it, replacing any manual
# session.
#MT5_TERMINAL_PATH=C:\Program Files\FBS MetaTrader 5\terminal64.exe
#MT5_PORTABLE=false
MT5_TIMEOUT_MS=60000
# FBS servers run on EET/EEST (UTC+2 / UTC+3, EU daylight saving). Verified at runtime.
BROKER_TIMEZONE=Europe/Athens
PAPER_ALLOW_MASTER_PASSWORD=false

# --- Trading permissions (Milestone 2; keep false) --------------------------------
ENABLE_DEMO_TRADING=false
ENABLE_LIVE_TRADING=false
# Must equal I-ACCEPT-LIVE-RISK-<MT5_LOGIN> for LIVE mode to start
LIVE_TRADING_CONFIRMATION=
MAGIC_NUMBER_BASE=7310000

# --- Risk overrides (percent of equity; override config.yaml when set) ---------
ALLOWED_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
MAX_RISK_PER_TRADE=0.5
MAX_DAILY_LOSS_PERCENT=2.0
MAX_ACCOUNT_DRAWDOWN_PERCENT=10.0
MAX_OPEN_POSITIONS=3
MAX_SPREAD_POINTS=30

# --- Safety ------------------------------------------------------------------------
KILL_SWITCH_FILE=data/KILL_SWITCH
KILL_SWITCH_FLATTEN_ALLOWED=false

# --- Storage & logs ----------------------------------------------------------------
ENGINE_DB_URL=sqlite:///data/taa_engine.db
CONFIG_FILE=config.yaml
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Optional AI assessment (Milestone 2) -------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MODE=veto

# --- Cloud sync to the Railway web service (enable in config.yaml: sync.enabled) ---
CLOUD_BASE_URL=
ENGINE_ID=
ENGINE_HMAC_SECRET=
# TOTP secret used ONLY on this machine to verify remote close/flatten commands
CONTROL_TOTP_SECRET=

# --- Web service: python -m app.web (on Railway these are service variables) --------
# development: no HSTS, the local dev origins (Vite :5173, app.web :8000) are accepted.
# production (the default when unset) requires WEB_PUBLIC_ORIGIN=https://...
WEB_ENV=development
DATABASE_URL=sqlite:///data/taa_cloud.db
WEB_PUBLIC_ORIGIN=
# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it ends every session and requires TOTP re-enrollment (python -m app.cli web reset-totp NAME).
WEB_SESSION_SECRET=
WEB_STATIC_DIR=frontend/dist
PORT=8000
